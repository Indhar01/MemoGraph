# Copy to deploy/.env and fill in. NEVER commit the populated file.
# All variables are optional unless explicitly marked required.

# --- Auth (Phase 1.1) ----------------------------------------------------

# Provider: none | api_key | oidc | multi
# Production deployments MUST set this to something other than "none".
MEMOGRAPH_AUTH_PROVIDER=api_key

# api_key mode: comma-separated list of plaintext keys. Hashed at startup.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
MEMOGRAPH_API_KEYS=

# oidc mode (works with WorkOS, Auth0, Clerk, Keycloak, etc.):
# MEMOGRAPH_OIDC_JWKS_URL=https://your-tenant.auth0.com/.well-known/jwks.json
# MEMOGRAPH_OIDC_AUDIENCE=https://api.memograph.example
# MEMOGRAPH_OIDC_ISSUER=https://your-tenant.auth0.com/

# --- Web hardening (Phase 1.2) -------------------------------------------

# Comma-separated CORS allowlist. Empty = no cross-origin requests allowed.
# MEMOGRAPH_CORS_ORIGINS=https://app.example.com,https://admin.example.com

# Body size cap (bytes). Default 1 MiB.
# MEMOGRAPH_MAX_BODY_BYTES=1048576

# Rate limiting. Defaults: 60/minute, in-memory. For multi-instance
# deployments, point at Redis: redis://redis:6379/0
# MEMOGRAPH_RATELIMIT_DEFAULT=60/minute
# MEMOGRAPH_RATELIMIT_STORAGE=memory://

# --- Storage caps (Phase 1.3) --------------------------------------------

# MEMOGRAPH_VAULT_SOFT_CAP_BYTES=5368709120     # 5 GiB
# MEMOGRAPH_VAULT_HARD_CAP_BYTES=53687091200    # 50 GiB

# --- Observability (Phase 2.1) ------------------------------------------

# Expose /metrics in Prometheus format. Lock down at the network level.
MEMOGRAPH_METRICS_ENABLED=1

# OTLP/HTTP endpoint. Set to enable distributed tracing. Examples:
#   Honeycomb: https://api.honeycomb.io/v1/traces (with x-honeycomb-team header)
#   Grafana:   https://otlp-gateway-prod-eu-west-0.grafana.net/otlp/v1/traces
# MEMOGRAPH_OTEL_EXPORTER_ENDPOINT=
# MEMOGRAPH_OTEL_SERVICE_NAME=memograph
# MEMOGRAPH_OTEL_HEADERS=

# --- Operational --------------------------------------------------------

# Set to 1 to enable verbose error responses (vault path on /api/health,
# stack traces in 500 bodies). NEVER enable in production.
# MEMOGRAPH_DEBUG=0

# Log level (DEBUG, INFO, WARNING, ERROR). Default INFO.
# MEMOGRAPH_LOG_LEVEL=INFO
